+def get_critical_label(tasks_index, overlapping_task_indices, critical_tasks):
+    """
+    Generate critical path labels for multi-task learning.
+
+    Args:
+        tasks_index: {(job_id, task_id): task_index} mapping
+        overlapping_task_indices: List of (job_id, task_id) in overlap region
+        critical_tasks: Set of (job_id, task_id) on critical path
+
+    Returns:
+        task_critical_idx: List of task indices (same as task_label_idx)
+        task_critical_label: List of binary labels (1 if on critical path, 0 otherwise)
+    """
+    task_critical_idx = [tasks_index[task] for task in overlapping_task_indices]
+    task_critical_label = [1 if task in critical_tasks else 0 for task in overlapping_task_indices]
+    return task_critical_idx, task_critical_label
